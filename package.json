{
  "name": "crazy-uno",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/index.ts --dev",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist-server/index.mjs",
    "start": "node dist-server/index.mjs",
    "test": "vitest run",
    "build:static": "vite build"
  },
  "dependencies": {
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.18.0",
    "qrcode-generator": "^1.4.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.170.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.170.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.3",
    "@types/node": "24.9.1"
  },
  "engines": {
    "node": ">=20"
  }
}
