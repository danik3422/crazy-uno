{
  "name": "crazy-uno",
  "private": true,
  "version": "2.0.0",
  "description": "Crazy UNO: a free 3D card game for the browser with bots, online rooms and crazy modes. A fan project, not affiliated with Mattel, Inc.",
  "license": "MIT",
  "author": "Danylo Syloats (https://danylodev.com/)",
  "homepage": "https://danylodev.com/projects/crazy-uno/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danik3422/crazy-uno.git"
  },
  "bugs": "https://github.com/danik3422/crazy-uno/issues",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/index.ts --dev",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist-server/index.mjs",
    "start": "node dist-server/index.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "build:static": "vite build"
  },
  "dependencies": {
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.18.0",
    "qrcode-generator": "^1.4.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.170.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "24.9.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.170.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
